{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apollo approved tool snapshot",
  "type": "object",
  "required": ["schema_version", "snapshot", "tools"],
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot": {
      "oneOf": [
        {
          "type": "object",
          "required": ["effective_at", "owner", "reviewed_by", "source_sha256", "source_url", "status"],
          "properties": {
            "effective_at": { "type": "string", "format": "date-time" },
            "owner": { "type": "string", "minLength": 1 },
            "reviewed_by": { "type": "string", "minLength": 1 },
            "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "status": { "const": "AUTHORITATIVE" }
          }
        },
        {
          "type": "object",
          "required": ["effective_at", "generated_at", "owner", "reviewed_by", "source_sha256", "source_url", "status"],
          "properties": {
            "effective_at": { "type": "null" },
            "generated_at": { "type": "null" },
            "owner": { "type": "null" },
            "reviewed_by": { "type": "null" },
            "source_sha256": { "type": "null" },
            "source_url": { "type": "null" },
            "status": { "const": "UNCONFIGURED" }
          }
        }
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "names", "delivery", "status", "scope", "data_classes", "conditions", "owner", "reviewed_at", "source_url"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "domains": { "type": "array", "items": { "type": "string" } },
          "repositories": { "type": "array", "items": { "type": "string" } },
          "packages": { "type": "array", "items": { "type": "string" } },
          "delivery": { "type": "array", "minItems": 1, "items": { "enum": ["CLI", "SaaS", "OSS", "library", "extension", "MCP", "hybrid"] } },
          "status": { "enum": ["APPROVED", "APPROVED_WITH_CONDITIONS", "RESTRICTED_OR_DENIED"] },
          "scope": { "type": "string", "minLength": 1 },
          "version_scope": { "type": ["string", "null"] },
          "data_classes": { "type": "array", "items": { "type": "string" } },
          "conditions": { "type": "array", "items": { "type": "string" } },
          "owner": { "type": "string", "minLength": 1 },
          "reviewed_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": ["string", "null"], "format": "date-time" },
          "source_url": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    }
  }
}
